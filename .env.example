# ==============================================================================
# NEXUS CLUB OPS - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and replace the placeholder values with your real keys.
# NEVER commit .env to version control or share client secrets publicly!
#
# Usage:
#   copy .env.example .env     (Windows CMD)
#   cp .env.example .env       (Linux / macOS / PowerShell)
# ==============================================================================

# Server Port (default: 3000)
PORT=3000

# Google OAuth 2.0 Web Application Client ID
# Obtain this from: Google Cloud Console -> APIs & Services -> Credentials -> Create Credentials -> OAuth client ID -> Web application
# Example format: 123456789012-abcdefghijklmnopqrstuvwxyz123456.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com

# Google OAuth 2.0 Client Secret (optional for client ID token verification; recommended for full OAuth code exchange)
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# Secret key used to sign server-side HMAC session tokens (generate a long, random string)
# Example: openssl rand -hex 32
SESSION_SECRET=replace_with_a_secure_random_string_for_production_sessions
